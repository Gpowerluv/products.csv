name: Run Pinterest Agent

# Trigger the script whenever products.csv is updated in the main branch
on:
  push:
    paths:
      - 'products.csv'
    branches:
      - main

jobs:
  post-to-pinterest:
    runs-on: ubuntu-latest

    steps:
      # Step 1: Grab the code from the repository
      - name: Checkout Repository
        uses: actions/checkout@v3

      # Step 2: Set up Python
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      # Step 3: Install necessary libraries
      - name: Install Dependencies
        run: pip install -r requirements.txt

      # Step 4: Run the agent using hidden secrets
      - name: Run Agent Script
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          PINTEREST_ACCESS_TOKEN: ${{ secrets.PINTEREST_ACCESS_TOKEN }}
          PINTEREST_BOARD_ID: ${{ secrets.PINTEREST_BOARD_ID }}
        run: python agent.py
